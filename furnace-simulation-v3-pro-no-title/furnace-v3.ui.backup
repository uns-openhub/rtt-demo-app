<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkBox" id="furnace_root">
    <property name="orientation">vertical</property>
    <property name="spacing">14</property>
    <property name="margin">20</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">18</property>
        <child>
          <object class="GtkImage" id="logo_image">
            <property name="width-request">190</property>
            <property name="height-request">55</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="furnace_title">
                <property name="label">Furnace Control</property>
                <property name="xalign">0</property>
                <attributes><attribute name="weight" value="bold"/><attribute name="scale" value="1.35"/></attributes>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Production order, furnace state and process visualization</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
          <packing><property name="expand">True</property></packing>
        </child>
      </object>
      <packing><property name="expand">False</property></packing>
    </child>

    <child>
      <object class="GtkFrame" id="order_frame">
        <property name="label">PRODUCTION ORDER</property>
        <property name="border-width">8</property>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">10</property><property name="column-spacing">12</property>
            <property name="margin">8</property>
            <child><object class="GtkLabel" id="flrecipe_entry"><property name="label">Recipe ID</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkEntry" id="recipe_entry"><property name="placeholder-text">s355-20mm</property></object><packing><property name="left-attach">1</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel" id="flmaterial_entry"><property name="label">Material No.</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkEntry" id="material_entry"><property name="placeholder-text">slab-002</property></object><packing><property name="left-attach">1</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="flquantity_entry"><property name="label">Quantity</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkEntry" id="quantity_entry"><property name="placeholder-text">5</property></object><packing><property name="left-attach">1</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="flrepeat"><property name="label">Repeat stage</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkComboBoxText" id="repeat_combo"><items><item id="">none</item><item id="furnace">furnace</item><item id="descaling">descaling</item><item id="rolling">rolling</item></items></object><packing><property name="left-attach">1</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkCheckButton" id="merge_check"><property name="label">Merge submitted materials after rolling</property></object><packing><property name="left-attach">2</property><property name="top-attach">0</property><property name="width">2</property></packing></child>
            <child><object class="GtkLabel" id="flmerge_input_entry"><property name="label">Merge inputs</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkEntry" id="merge_input_entry"><property name="placeholder-text">slab-001, slab-002</property></object><packing><property name="left-attach">3</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="flmerge_output_entry"><property name="label">Merge output</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkEntry" id="merge_output_entry"><property name="placeholder-text">merged-slab</property></object><packing><property name="left-attach">3</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkBox">
              <property name="spacing">8</property>
              <child><object class="GtkButton" id="submit_production"><property name="label">Submit Production</property></object></child>
              <child><object class="GtkButton" id="refresh_furnace"><property name="label">Refresh Status</property></object></child>
              <child><object class="GtkLabel" id="production_status_label"><property name="label">Ready</property><property name="xalign">0</property></object><packing><property name="expand">True</property><property name="fill">True</property></packing></child>
            </object><packing><property name="left-attach">0</property><property name="top-attach">4</property><property name="width">4</property></packing></child>
          </object>
        </child>
      </object>
      <packing><property name="expand">False</property></packing>
    </child>

    <child>
      <object class="GtkFrame" id="visual_frame">
        <property name="label">FURNACE PROCESS</property>
        <property name="border-width">8</property>
        <child>
          <object class="GtkBox" orientation="horizontal" spacing="16">
            <property name="margin">8</property>
            <child>
              <object class="GtkBox" orientation="vertical" spacing="8">
                <child><object class="GtkLabel" id="industrial_title"><property name="label">Industrial Furnace</property><property name="xalign">0</property></object></child>
                <child><object class="GtkImage" id="furnace_drawing"><property name="width-request">640</property><property name="height-request">285</property></object><packing><property name="expand">True</property><property name="fill">True</property></packing></child>
              </object>
              <packing><property name="expand">True</property><property name="fill">True</property></packing>
            </child>
            <child>
              <object class="GtkBox" orientation="vertical" spacing="10">
                <child><object class="GtkLabel" id="furnace_green"><property name="label">ON</property><property name="xalign">0</property></object></child>
                <child><object class="GtkLabel" id="furnace_red"><property name="label">OFF</property><property name="xalign">0</property></object></child>
              </object>
              <packing><property name="expand">False</property></packing>
            </child>
          </object>
        </child>
      </object>
      <packing><property name="expand">True</property><property name="fill">True</property></packing>
    </child>

    <child>
      <object class="GtkFrame" id="status_frame">
        <property name="label">FURNACE STATIONS</property>
        <property name="border-width">8</property>
        <child>
          <object class="GtkGrid">
            <property name="column-spacing">12</property><property name="row-spacing">8</property><property name="margin">8</property>
            <child><object class="GtkLabel"><property name="label">Station</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Status</property><property name="xalign">0</property></object><packing><property name="left-attach">1</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Temperature</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Material</property><property name="xalign">0</property></object><packing><property name="left-attach">3</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Stage</property><property name="xalign">0</property></object><packing><property name="left-attach">4</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Production</property><property name="xalign">0</property></object><packing><property name="left-attach">5</property><property name="top-attach">0</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Furnace 1</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="f1_status"><property name="label">UNKNOWN</property><property name="xalign">0</property></object><packing><property name="left-attach">1</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="f1_temperature"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="f1_material"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">3</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="f1_stage"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">4</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel" id="f1_production"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">5</property><property name="top-attach">1</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Furnace 2</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="f2_status"><property name="label">UNKNOWN</property><property name="xalign">0</property></object><packing><property name="left-attach">1</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="f2_temperature"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="f2_material"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">3</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="f2_stage"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">4</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel" id="f2_production"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">5</property><property name="top-attach">2</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Furnace 3</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel" id="f3_status"><property name="label">UNKNOWN</property><property name="xalign">0</property></object><packing><property name="left-attach">1</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel" id="f3_temperature"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel" id="f3_material"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">3</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel" id="f3_stage"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">4</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel" id="f3_production"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">5</property><property name="top-attach">3</property></packing></child>
            <child><object class="GtkLabel"><property name="label">Furnace 4</property><property name="xalign">0</property></object><packing><property name="left-attach">0</property><property name="top-attach">4</property></packing></child>
            <child><object class="GtkLabel" id="f4_status"><property name="label">UNKNOWN</property><property name="xalign">0</property></object><packing><property name="left-attach">1</property><property name="top-attach">4</property></packing></child>
            <child><object class="GtkLabel" id="f4_temperature"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">2</property><property name="top-attach">4</property></packing></child>
            <child><object class="GtkLabel" id="f4_material"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">3</property><property name="top-attach">4</property></packing></child>
            <child><object class="GtkLabel" id="f4_stage"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">4</property><property name="top-attach">4</property></packing></child>
            <child><object class="GtkLabel" id="f4_production"><property name="label">--</property><property name="xalign">0</property></object><packing><property name="left-attach">5</property><property name="top-attach">4</property></packing></child>
          </object>
        </child>
      </object>
      <packing><property name="expand">False</property></packing>
    </child>
  </object>
</interface>
