{
  "name": "rtt-demo-app",
  "version": "6.1.12",
  "private": true,
  "description": "OpenHub RTT demo add-on with a hot rolling mill MQTT simulator and API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uns-openhub/rtt-demo-app.git"
  },
  "homepage": "https://github.com/uns-openhub/rtt-demo-app#readme",
  "bugs": {
    "url": "https://github.com/uns-openhub/rtt-demo-app/issues"
  },
  "unsDatahub": {
    "schemaVersion": 1,
    "kind": "addon",
    "controllerCompatibility": ">=2 <3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "verify": "pnpm run test && pnpm run typecheck && pnpm run build",
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "hrm:submit": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/hrm-submit.ts",
    "hrm:watch": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/hrm-watch.ts",
    "subasset:example": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/subasset-publish-example.ts",
    "generate-config-schema": "node ./node_modules/@uns-kit/core/dist/tools/generate-config-schema.js",
    "generate-uns-dictionary": "node ./node_modules/@uns-kit/core/dist/tools/generate-uns-dictionary.js",
    "generate-uns-measurements": "node ./node_modules/@uns-kit/core/dist/tools/generate-uns-measurements.js",
    "generate-uns-reference": "node ./node_modules/@uns-kit/core/dist/tools/generate-uns-reference.js",
    "generate-uns-topics-tags": "node ./node_modules/@uns-kit/core/dist/tools/refresh-uns.js",
    "sync-uns-schema": "node ./node_modules/@uns-kit/core/dist/tools/sync-uns-schema.js",
    "sync-uns-metadata": "node ./node_modules/@uns-kit/core/dist/tools/sync-uns-metadata.js",
    "check-release-version": "node scripts/check-release-version.mjs"
  },
  "dependencies": {
    "@uns-kit/api": "^3.0.10",
    "@uns-kit/core": "^3.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.3"
}
